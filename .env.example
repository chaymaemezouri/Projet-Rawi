ENVIRONMENT=development
# Hôte local. Dans Compose, le backend utilise db:5432 et ignore cette adresse.
# Si 5432 est déjà pris : POSTGRES_PORT=5434 et localhost:5434 ici.
DATABASE_URL=postgresql+psycopg://rawi:rawi@localhost:5432/rawi
POSTGRES_PORT=5432
JWT_SECRET=change-me-in-local-env-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173
ADMIN_EMAIL=admin@rawi.local
ADMIN_PASSWORD=change-me-admin
ADMIN_NAME=Administrateur RAWI
