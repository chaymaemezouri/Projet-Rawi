# Copier vers .env.production puis remplacer chaque valeur AVANT le premier démarrage.
# Les valeurs qui commencent par change-me sont refusées. Ne pas commiter .env.production.
# Mots de passe : lettres et chiffres seulement, pour éviter de casser l'URL de la base.
#
# docker compose --env-file .env.production -f docker-compose.prod.yml up --build -d
# Le site reste sur 127.0.0.1:8080. Le nginx déjà présent sur le serveur publie uniquement rawi.academyskills.net.

POSTGRES_PASSWORD=change-me-db-password
JWT_SECRET=change-me-use-32-random-characters-minimum
ADMIN_EMAIL=admin@exemple.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Administrateur RAWI

# Adresse publique du site, avec https, sans slash final.
CORS_ORIGINS=https://rawi.academyskills.net

# Le site compilé n'écoute que sur le serveur. Le nginx du serveur le publie.
WEB_BIND=127.0.0.1
WEB_PORT=8080
